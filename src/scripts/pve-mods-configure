#!/usr/bin/env bash
#
# pve-mods-configure - Interactive configuration tool for pve-mods
# Detects hardware, asks the user which features to enable, writes
# /etc/pve-mods/pve-mods.conf, and applies patches to PVE system files.
#
# Module-specific logic lives in /usr/lib/pve-mods/configure.d/<mod>.sh,
# sourced at startup. Each module file provides the standard four-function
# API: <mod>_defaults, <mod>_load_conf, <mod>_configure, <mod>_write_conf.

set -euo pipefail

CONF_FILE="${PVE_MODs_MAIN_CONF:-/etc/pve-mods/pve-mods.conf}"
CONFD_DIR="${PVE_MODs_CONFD_DIR:-/etc/pve-mods/conf.d}"
APPLY_PATCHES="/usr/lib/pve-mods/apply-patches.sh"
REVERT_PATCHES="/usr/lib/pve-mods/revert-patches.sh"
NODES_PM="/usr/share/perl5/PVE/API2/Nodes.pm"
PVE_MODs_ROOT="${PVE_MODs_ROOT:-/}"
source "${PVE_MODs_TRANSACTION_HELPER:-/usr/lib/pve-mods/patch-transaction.sh}"
declare -A WIZARD_HASHES
wizard_hash() {
    [[ ! -L "$1" ]] || return 1
    if [[ -f "$1" ]]; then transaction_hash "$1"; else echo missing; fi
}
wizard_unlock() {
    flock -u "$PVE_MODs_LOCK_FD"
    exec {PVE_MODs_LOCK_FD}>&-
}
wizard_snapshot() {
    local file
    for file in "$CONF_FILE" "$CONFD_DIR/node_info.conf" "$CONFD_DIR/nag_screen.conf"; do
        WIZARD_HASHES["$file"]=$(wizard_hash "$file") || return 1
    done
}
wizard_save() {
    local module="${1:-}" file stage failed=false main_target="$CONF_FILE"
    local -a targets=("$CONF_FILE") written=()
    [[ -z "$module" ]] || targets=("$CONFD_DIR/$module.conf" "$CONF_FILE")
    stage=$(mktemp -d) || return 1
    mkdir -p "$stage/new" "$stage/old"
    [[ ! -f "$CONFD_DIR/nag_screen.conf" ]] || cp -a "$CONFD_DIR/nag_screen.conf" "$stage/new/nag_screen.conf" || { rm -rf "$stage"; return 1; }
    # Render after prompts and any module package installation, without a lock.
    (
        CONF_FILE="$stage/new/main.conf"
        NODE_INFO_CONF="$stage/new/node_info.conf"
        NAG_SCREEN_CONF="$stage/new/nag_screen.conf"
        write_main_conf
        [[ -z "$module" ]] || "${module}_write_conf"
    ) || { rm -rf "$stage"; return 1; }
    transaction_lock || { rm -rf "$stage"; return 1; }
    # All values were loaded together; refuse to overwrite a concurrent CLI or
    # wizard edit, even to a config not selected by this invocation.
    for file in "${!WIZARD_HASHES[@]}"; do
        if [[ "$(wizard_hash "$file")" != "${WIZARD_HASHES[$file]}" ]]; then
            warn 'Configuration changed while the wizard was open. Rerun it.'
            wizard_unlock; rm -rf "$stage"; return 1
        fi
    done
    mkdir -p "$(dirname "$main_target")" "$CONFD_DIR"
    for file in "${targets[@]}"; do
        local name="${file##*/}"
        [[ "$file" != "$main_target" ]] || name=main.conf
        if [[ -f "$file" ]]; then
            cp -a "$file" "$stage/old/$name" || { failed=true; break; }
            chmod --reference="$file" "$stage/new/$name" || { failed=true; break; }
            chown --reference="$file" "$stage/new/$name" || { failed=true; break; }
        else
            chmod 644 "$stage/new/$name" || { failed=true; break; }
        fi
        written+=("$file")
        if ! transaction_replace "$stage/new/$name" "$file"; then failed=true; break; fi
    done
    if [[ "$failed" == true ]]; then
        for file in "${written[@]}"; do
            local name="${file##*/}"
            [[ "$file" != "$main_target" ]] || name=main.conf
            if [[ -f "$stage/old/$name" ]]; then transaction_replace "$stage/old/$name" "$file" || true
            else rm -f "$file"; fi
        done
    fi
    wizard_unlock
    rm -rf "$stage"
    [[ "$failed" == false ]]
}

#region helpers
# Blank-line spacing rule: section() is the only place that emits a leading
# blank line, so every block in the wizard is separated by exactly one blank
# line. Other helpers (info/warn/ask) never add their own surrounding blanks.
msgb()    { echo -e "\e[1m${1}\e[0m"; }
section() { echo -e "\n\e[1m=== ${1} ===\e[0m"; }
info() { echo -e "\e[0;32m[info] ${1}\e[0m"; }
warn() { echo -e "\e[0;33m[warning] ${1}\e[0m"; }
err()  { echo -e "\e[0;31m[error] ${1}\e[0m"; exit 1; }
ask()  {
    local prompt="$1" response
    read -r -p $'\e[1;36m'"${prompt}:"$'\e[0m ' response
    echo "$response"
}
bool() { [[ "$1" == true ]] && echo 1 || echo 0; }
mod_status() {
    local val="$1" on_label="${2:-[enabled]}" off_label="${3:-[disabled]}"
    [[ "$val" == "1" ]] && echo -e "\e[0;32m${on_label}\e[0m" || echo -e "\e[0;33m${off_label}\e[0m"
}
#endregion helpers

# Source all module configure scripts. Override CONFIGURE_D_DIR for testing.
CONFIGURE_D_DIR="${PVE_MODs_CONFIGURE_D:-/usr/lib/pve-mods/configure.d}"
for _f in "${CONFIGURE_D_DIR}"/*.sh; do
    [[ -f "$_f" ]] || continue
    # shellcheck source=/dev/null
    source "$_f"
done; unset _f

_load_main_conf() {
    [[ -f "$CONF_FILE" ]] || return 0
    local section="" line key val
    while IFS= read -r line; do
        case "$line" in
            '#'*|'') continue ;;
            '['*']') section="${line#[}"; section="${section%]}"; continue ;;
        esac
        [[ "$line" == *=* ]] || continue
        key="${line%%=*}"; val="${line#*=}"
        case "${section}.${key}" in
            modules.node_info)    MOD_NODE_INFO="$val" ;;
            modules.nag_screen)   MOD_NAG_SCREEN="$val" ;;
            pve_trigger.enabled)  PVE_TRIGGER_ENABLED="$val" ;;
        esac
    done < "$CONF_FILE"
}

write_main_conf() {
    mkdir -p "$(dirname "$CONF_FILE")" "$CONFD_DIR"
    cat > "$CONF_FILE" <<EOF
# pve-mods main configuration file
# Managed by pve-mods-configure. Re-run to update.
#
# This file only declares which mods are enabled. Each mod keeps its own
# settings in ${CONFD_DIR}/<mod>.conf

[modules]
node_info=${MOD_NODE_INFO}
nag_screen=${MOD_NAG_SCREEN}

[pve_trigger]
enabled=${PVE_TRIGGER_ENABLED}
EOF
    info "Main configuration saved to $CONF_FILE"
}

main() {
    # ── Welcome banner ────────────────────────────────────────────────────────
    local _version
    _version=$(dpkg-query -W -f='${Version}' pve-mods 2>/dev/null || echo "unknown")
    echo -e "\e[1;34m"
    echo "  ██████╗ ██╗   ██╗███████╗    ███╗   ███╗ ██████╗ ██████╗ ███████╗"
    echo "  ██╔══██╗██║   ██║██╔════╝    ████╗ ████║██╔═══██╗██╔══██╗██╔════╝"
    echo "  ██████╔╝██║   ██║█████╗      ██╔████╔██║██║   ██║██║  ██║███████╗"
    echo "  ██╔═══╝ ╚██╗ ██╔╝██╔══╝      ██║╚██╔╝██║██║   ██║██║  ██║╚════██║"
    echo "  ██║      ╚████╔╝ ███████╗    ██║ ╚═╝ ██║╚██████╔╝██████╔╝███████║"
    echo "  ╚═╝       ╚═══╝  ╚══════╝    ╚═╝     ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝"
    echo -e "\e[0m"
    echo -e "\e[1m  PVE-mods Configurator  \e[0;36mv${_version}\e[0m"
    echo -e "  Proxmox VE enhancement suite — hardware monitoring, GPU info & more\n"

    # ── Root check ────────────────────────────────────────────────────────────
    [[ $EUID -eq 0 ]] || err "This script must be run as root."

    # ── Prerequisite check ────────────────────────────────────────────────────
    if [[ ! -x "$APPLY_PATCHES" ]]; then
        err "pve-mods is not installed (cannot find $APPLY_PATCHES).\nInstall it first: dpkg -i pve-mods_*.deb"
    fi

    # ── Legacy installation check ─────────────────────────────────────────────
    if grep -qF '$res->{sensorsJSONOutput}' "$NODES_PM" 2>/dev/null || \
       grep -qF '$res->{systemInfo}' "$NODES_PM" 2>/dev/null; then
        err "A legacy pve-mods bash-script installation was detected in Nodes.pm.\nRemove it first:\n  bash /path/to/pve-mods-gui-sensors.sh uninstall"
    fi

    # ── Initialize all config variables with safe defaults ────────────────────
    MOD_NODE_INFO=0; MOD_NAG_SCREEN=0; PVE_TRIGGER_ENABLED=0
    node_info_defaults
    nag_screen_defaults
    transaction_lock
    wizard_snapshot
    _load_main_conf
    node_info_load_conf
    nag_screen_load_conf
    wizard_unlock

    # ── Module / feature selection ────────────────────────────────────────────
    # Existing settings are loaded above; the user picks ONE option to (re)configure
    # this run, and all other options retain their previously saved values.
    section "pve-mods Module Selection"
    echo "Available options (select one):"
    echo -e "  [1] Node Info   $(mod_status "$MOD_NODE_INFO") — sensor readings, GPU stats, UPS, system information"
    echo -e "  [2] Nag Screen  $(mod_status "$MOD_NAG_SCREEN") — remove Proxmox subscription nag screen"
    echo -e "  [3] Auto re-patch on PVE upgrade $(mod_status "$PVE_TRIGGER_ENABLED") — automatically re-apply patches when"
    echo    "                    pve-manager is upgraded"
    echo    "  [n] None / cancel"
    local modChoice selected_mod="" patching_needed=0
    modChoice=$(ask "Select an option (1/2/3/n)")
    case "$modChoice" in
        1)
            selected_mod="node_info"
            if [[ "$MOD_NODE_INFO" == "1" ]]; then
                MOD_NODE_INFO=0; info "Node Info will be removed."
            else
                MOD_NODE_INFO=1; patching_needed=1
                section "Node Info Configuration"
                node_info_configure
            fi
            # Write before patching so pveproxy restarts with the new config.
            wizard_save node_info
            ;;
        2)
            selected_mod="nag_screen"
            if [[ "$MOD_NAG_SCREEN" == "1" ]]; then
                MOD_NAG_SCREEN=0; info "Nag Screen will be removed."
            else
                MOD_NAG_SCREEN=1; patching_needed=1
                info "Subscription nag screen removal will be applied."
                nag_screen_configure
            fi
            # Write before patching so pveproxy restarts with the new config.
            wizard_save nag_screen
            ;;
        3)
            if [[ "$PVE_TRIGGER_ENABLED" == "1" ]]; then
                PVE_TRIGGER_ENABLED=0; info "Auto re-patch disabled."
            else
                PVE_TRIGGER_ENABLED=1; info "Auto re-patching on PVE upgrade enabled."
            fi
            wizard_save  # no patches for this option
            ;;
        [nN]) info "No option selected. Exiting."; exit 0 ;;
        *)    warn "Invalid selection. Exiting."; exit 0 ;;
    esac

    # ── Apply / revert patches ────────────────────────────────────────────────
    # Config is already written above; pveproxy will restart with new settings.
    if [[ "$patching_needed" == "1" ]]; then
        section "Applying patches"
        if ! "$APPLY_PATCHES" "$selected_mod"; then
            err "Could not apply all patches for $selected_mod."
        fi
    elif [[ -n "$selected_mod" ]]; then
        section "Removing patches"
        if ! "$REVERT_PATCHES" "$selected_mod"; then
            err "Could not revert all patches for $selected_mod."
        fi
    fi

    section "Done"
    info "pve-mods is configured and active."
    info "Clear your browser cache to see the changes."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main; fi
